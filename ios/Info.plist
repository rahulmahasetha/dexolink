    <string>DexoLink connects to your Mac, Windows PC, or Android device on the local network for fast file and clipboard sharing without internet.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_dexolink._tcp</string>
        <string>_macdroid._tcp</string>
    </array>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>DexoLink allows you to select photos and videos to transfer directly to your paired devices.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>DexoLink saves incoming photos and videos from your paired devices to your Photos library.</string>
    <key>NSCameraUsageDescription</key>
    <string>DexoLink streams camera video feed to your paired devices when Camera Sharing is enabled.</string>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60</string>
            </array>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
        </dict>
    </dict>
    <key>CFBundleIcons~ipad</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60</string>
                <string>AppIcon76x76</string>
            </array>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
        </dict>
    </dict>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>processing</string>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
